@using System.IO
@using Med_Vehicle.Services 
@inject IFileUploadService UploadService

<div class="image-upload-wrapper">
    <InputFile OnChange="HandleFileSelected" accept=".png,.jpg,.jpeg" class="form-control mb-2" />

    <div class="card p-2" style="width: 300px;">
        @if (!string.IsNullOrEmpty(CurrentFileName))
        {
            <p class="text-muted small mb-1">Current Image:</p>

            <img src="/uploads/@CurrentFileName?v=@DateTime.Now.Ticks" class="img-fluid rounded" />
        }
        else
        {
            <div class="text-center p-4 bg-light text-muted">
                No Image Selected
            </div>
        }
    </div>

    @if (isLoading) 
    { 
        <div class="text-info mt-1">
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            Uploading...
        </div> 
    }
    @if (!string.IsNullOrEmpty(errorMessage)) 
    { 
        <div class="text-danger mt-1 small">@errorMessage</div> 
    }
</div>

@code {
    [Parameter] public string? CurrentFileName { get; set; }
    [Parameter] public EventCallback<string> OnUploadComplete { get; set; }
    [Parameter] public long MaxFileSize { get; set; } = 1024 * 1024 * 5; // 5 MB default

    private bool isLoading;
    private string? errorMessage;

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        isLoading = true;
        errorMessage = null;

        var file = e.File;
        try
        {
            var storedFileName = await UploadService.UploadFileAsync(file, MaxFileSize);
            
            if (!string.IsNullOrEmpty(storedFileName))
            {
                CurrentFileName = storedFileName; 
                await OnUploadComplete.InvokeAsync(storedFileName);
            }
            else
            {
                errorMessage = "Upload failed. The server returned an empty filename.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Upload failed. Please try again.";
            Console.WriteLine($"Upload Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}