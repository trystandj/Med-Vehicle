@page "/AddModification/{PublicId}"
@using Med_Vehicle.Models
@using Med_Vehicle.MongoDB
@inject VehicleModificationService ModificationService
@inject CarService CarService
@inject NavigationManager Navigation

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h3 class="mb-0">Add Modification</h3>
                </div>
                <div class="card-body">
                    
                    @if (isLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-success" role="status"></div>
                            <p class="mt-2">Verifying vehicle...</p>
                        </div>
                    }
                    else if (relatedCar == null)
                    {
                        <div class="alert alert-danger">
                            Vehicle not found or access denied.
                        </div>
                        <a href="/MyCars" class="btn btn-secondary">Back to Garage</a>
                    }
                    else
                    {
                        <div class="mb-3">
                            <small class="text-muted">Adding modification for:</small>
                            <div class="fw-bold">@relatedCar.Year @relatedCar.Make @relatedCar.Model</div>
                        </div>

                        <EditForm Model="newMod" OnValidSubmit="HandleValidSubmit">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label class="form-label">Modification Name</label>
                                <InputText @bind-Value="newMod.Modification" class="form-control" placeholder="e.g. Cold Air Intake, Lift Kit" />
                                <ValidationMessage For="@(() => newMod.Modification)" class="text-danger small" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Date Installed</label>
                                <InputDate @bind-Value="newMod.DateInstalled" class="form-control" />
                                <ValidationMessage For="@(() => newMod.DateInstalled)" class="text-danger small" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Notes</label>
                                <InputTextArea @bind-Value="newMod.Notes" class="form-control" rows="3" placeholder="Part numbers, brand, specific settings..." />
                                <ValidationMessage For="@(() => newMod.Notes)" class="text-danger small" />
                            </div>

                            <div class="d-grid gap-2 d-md-flex justify-content-md-end border-top pt-3">
                                <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">Cancel</button>
                                <button type="submit" class="btn btn-success px-4">Save Modification</button>
                            </div>

                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string PublicId { get; set; } = string.Empty;

    private VehicleModifications newMod = new() { DateInstalled = DateTime.Today };
    
    private Car? relatedCar;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            relatedCar = await CarService.GetByPublicIdAsync(PublicId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error finding car: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleValidSubmit()
    {
        if (relatedCar == null || relatedCar.Id == null) return;

        try
        {

            newMod.CarId = relatedCar.Id;

            await ModificationService.CreateAsync(newMod);

            Navigation.NavigateTo($"/CarDetails/{PublicId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving modification: {ex.Message}");
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo($"/CarDetails/{PublicId}");
    }
}