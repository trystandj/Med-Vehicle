@page "/AddHistory/{PublicId}"
@using Med_Vehicle.Models
@using Med_Vehicle.MongoDB
@inject HistoryService HistoryService
@inject CarService CarService
@inject NavigationManager Navigation

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Add Service Record</h3>
                </div>
                <div class="card-body">
                    
                    @if (isLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="mt-2">Verifying vehicle...</p>
                        </div>
                    }
                    else if (relatedCar == null)
                    {
                        <div class="alert alert-danger">
                            Vehicle not found or access denied.
                        </div>
                        <a href="/MyCars" class="btn btn-secondary">Back to Garage</a>
                    }
                    else
                    {
                        <div class="mb-3">
                            <small class="text-muted">Adding record for:</small>
                            <div class="fw-bold">@relatedCar.Year @relatedCar.Make @relatedCar.Model</div>
                        </div>

                        <EditForm Model="newHistory" OnValidSubmit="HandleValidSubmit">
                            <DataAnnotationsValidator />


                            <div class="mb-3">
                                <label class="form-label">Event / Service Type</label>
                                <InputText @bind-Value="newHistory.Event" class="form-control" placeholder="e.g. Oil Change, Tire Rotation" />
                                <ValidationMessage For="@(() => newHistory.Event)" class="text-danger small" />
                            </div>


                            <div class="mb-3">
                                <label class="form-label">Date</label>
                                <InputDate @bind-Value="newHistory.DateOfEvent" class="form-control" />
                                <ValidationMessage For="@(() => newHistory.DateOfEvent)" class="text-danger small" />
                            </div>


                            <div class="mb-3">
                                <label class="form-label">Notes</label>
                                <InputTextArea @bind-Value="newHistory.Notes" class="form-control" rows="3" placeholder="Any additional details..." />
                                <ValidationMessage For="@(() => newHistory.Notes)" class="text-danger small" />
                            </div>

                            <div class="d-grid gap-2 d-md-flex justify-content-md-end border-top pt-3">
                                <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">Cancel</button>
                                <button type="submit" class="btn btn-primary px-4">Save Record</button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string PublicId { get; set; } = string.Empty;

    private History newHistory = new() { DateOfEvent = DateTime.Today };
    private Car? relatedCar;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            relatedCar = await CarService.GetByPublicIdAsync(PublicId);
            

        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error finding car: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleValidSubmit()
    {
        if (relatedCar == null || relatedCar.Id == null) return;

        try
        {

            newHistory.CarId = relatedCar.Id;

            await HistoryService.CreateAsync(newHistory);
            
            Navigation.NavigateTo($"/CarDetails/{PublicId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving history: {ex.Message}");
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo($"/CarDetails/{PublicId}");
    }
}