@page "/CarDetails/{PublicId}"
@using Med_Vehicle.Models
@using Med_Vehicle.MongoDB
@using Med_Vehicle.Components 
@inject CarService CarService
@inject NavigationManager Navigation

<div class="container mt-6">
    
    @if (isLoading)
    {
        <div class="d-flex justify-content-center align-items-center" style="height: 50vh;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (car is null)
    {
        <div class="alert alert-warning shadow-sm">
            <h4 class="alert-heading"><i class="bi bi-exclamation-triangle-fill"></i> Vehicle Not Found</h4>
            <p>The vehicle you are looking for does not exist or you do not have permission to view it.</p>
            <hr>
            <a href="/MyCars" class="btn btn-outline-dark">Back to My Garage</a>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-0">@car.Year @car.Make @car.Model</h2>
                <span class="text-muted small">
                    <i class="bi bi-upc-scan"></i> VIN: @car.Vin
                </span>
            </div>
            <div class="btn-group">
                <a href="/EditVehicle/@car.PublicId" class="btn btn-outline-secondary">
                    <i class="bi bi-pencil"></i> Edit
                </a>
                <a href="/DeleteVehicle/@car.PublicId" class="btn btn-outline-danger">
                    <i class="bi bi-trash"></i> Delete
                </a>
            </div>
        </div>

        <div class="row g-4">
            
                <div class="card shadow-sm mb-4 border-0">
                    
                    <div class="bg-light text-center overflow-hidden" style="max-height: 400px;">
                        @if (!string.IsNullOrEmpty(car.ImageFileName))
                        {
                            <img src="/uploads/@car.ImageFileName" class="img-fluid w-100" style="object-fit: contain; max-height: 400px;" alt="@car.Make @car.Model" />
                        }
                        else
                        {
                            <div class="py-5 text-muted">
                                <i class="bi bi-car-front display-1"></i>
                                <p class="mt-3">No Image Available</p>
                            </div>
                        }
                    </div>
                    <div class="card-body">
                        <div class="row text-center mb-4 g-3">
                            <div class="col-4">
                                <div class="p-3 border rounded bg-light">
                                    <small class="text-uppercase text-muted d-block mb-1">Mileage</small>
                                    <span class="fw-bold fs-5">@car.Mileage.ToString("N0")</span>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-3 border rounded bg-light">
                                    <small class="text-uppercase text-muted d-block mb-1">Color</small>
                                    <span class="fw-bold fs-5">@car.Color</span>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-3 border rounded bg-light">
                                    <small class="text-uppercase text-muted d-block mb-1">Type</small>
                                    @if (car.IsElectric)
                                    {
                                        <span class="badge bg-success">Electric</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Gasoline</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <h5 class="fw-bold">Notes</h5>
                        <p class="text-muted">
                            @(string.IsNullOrEmpty(car.Description) ? "No description provided for this vehicle." : car.Description)
                        </p>
                    </div>
                </div>
            


            <div class="col-md-6">
                <CarHistoryCard CarId="@car.Id" PublicId="@car.PublicId" />
            </div>


            <div class="col-md-6">
                <VehicleModificationsCard CarId="@car.Id" PublicId="@car.PublicId" />
            </div>
            
            <div class="col-12">

            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string PublicId { get; set; } = string.Empty;

    private Car? car;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {

            car = await CarService.GetByPublicIdAsync(PublicId);

        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading vehicle: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}
