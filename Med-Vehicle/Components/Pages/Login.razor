@page "/login"
@rendermode InteractiveServer
@inject UserService UserService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<div class="container mt-5">
    <h3>Login Med-Vehicle</h3>
    @if (error != null) { <div class="alert alert-danger">@error</div> }
    <input @bind="email" class="form-control mb-2" placeholder="E-mail" />
    <input @bind="pass" type="password" class="form-control mb-2" placeholder="Password" />
    <button @onclick="HandleLogin" class="btn btn-primary">Sign In</button>
</div>

@code {
    string email, pass, error;
    async Task HandleLogin() {
        var result = await UserService.GetUserAsync(email, pass);
        if (result != null) {
            await ((CustomAuthStateProvider)AuthStateProvider).UpdateAuthenticationState(result);
            Nav.NavigateTo("/");
        } else { error = "Incorrect."; }
    }
}